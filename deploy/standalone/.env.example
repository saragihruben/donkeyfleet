# Copy to .env to override the defaults baked into docker-compose.yml.
# Every value here already has a default in the compose file, so the stack runs
# without a .env at all — this only exists to make the knobs visible.

# The published DonkeyFleet image to pull (distribution mode). Set this to your
# registry ref, e.g. yourname/donkeyfleet:1.0.0. In this source repo the compose
# override builds this same tag from source instead, so the default is fine for dev.
DONKEYFLEET_IMAGE=saragihruben29/donkeyfleet:1.0.0

# Vault dev-mode root token. DonkeyFleet uses this same token to authenticate.
VAULT_TOKEN=donkeyfleet-root

# Keycloak realm / client. These MUST match keycloak/realm-export.json.
KC_REALM=donkeyfleet
KC_CLIENT_ID=donkeyfleet
KC_CLIENT_SECRET=donkeyfleet-local-secret

# Normal full observation cadence. Long-running baselines are monitored on this cadence.
RECONCILE_INTERVAL=5m

# Safe follow-up cadence while volume/relationship creation jobs are active. This does not
# bypass Observe, the PostgreSQL advisory lock, or persisted ONTAP job checkpoints.
PROVISIONING_POLL_INTERVAL=15s

# Start safely in dry-run. The standalone stack deliberately unlocks the audited administrator
# UI override so Apply Live can be exercised without editing Compose and restarting the app.
RECONCILE_DRY_RUN=true
RECONCILE_DRY_RUN_UI_OVERRIDE=true
